file(MAKE_DIRECTORY "${TEST_DIR}")

function(run_cli expected)
    execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
    if(NOT "${result}" STREQUAL "${expected}")
        message(FATAL_ERROR "CLI ${ARGN}: expected ${expected}, got ${result}\n${output}\n${error}")
    endif()
    set(LAST_OUTPUT "${output}${error}" PARENT_SCOPE)
endfunction()

run_cli(0 run --schedule 0,0,1,1 --trace "${TEST_DIR}/serial.json")
if(NOT LAST_OUTPUT MATCHES "counter=2")
    message(FATAL_ERROR "serial run did not produce counter=2")
endif()
run_cli(1 run --schedule 0,1,0,1 --trace "${TEST_DIR}/failure.json")
if(NOT LAST_OUTPUT MATCHES "counter=1")
    message(FATAL_ERROR "lost-update run did not produce counter=1")
endif()
run_cli(1 replay "${TEST_DIR}/failure.json")
if(NOT LAST_OUTPUT MATCHES "Replay verified")
    message(FATAL_ERROR "replay did not verify the complete trace")
endif()
run_cli(0 replay "${TEST_DIR}/serial.json")
run_cli(1 explore --out "${TEST_DIR}/failures")
if(NOT LAST_OUTPUT MATCHES "runs=6 failures=4 frontier_exhausted=true incomplete=false")
    message(FATAL_ERROR "unexpected exploration result: ${LAST_OUTPUT}")
endif()

file(READ "${TEST_DIR}/named/failure-1.json" recorded)
string(JSON counter GET "${recorded}" events 0 shared_state_before 0 value)
string(JSON failed_counter GET "${recorded}" outcome shared_state 0 value)
if(NOT counter EQUAL 0 OR NOT failed_counter EQUAL 1)
    message(FATAL_ERROR "shared-state snapshots were not recorded correctly")
endif()
string(JSON changed SET "${recorded}" events 0 runnable "[0]")
string(JSON changed SET "${changed}" events 0 threads 1 state "\"blocked\"")
file(WRITE "${TEST_DIR}/runnable.json" "${changed}")
run_cli(2 replay "${TEST_DIR}/runnable.json")
if(NOT LAST_OUTPUT MATCHES "divergence at step 0: runnable set")
    message(FATAL_ERROR "runnable set divergence was not explicit: ${LAST_OUTPUT}")
endif()
string(JSON changed SET "${recorded}" events 0 operation "\"store\"")
file(WRITE "${TEST_DIR}/operation.json" "${changed}")
run_cli(2 replay "${TEST_DIR}/operation.json")
if(NOT LAST_OUTPUT MATCHES "divergence at step 0: operation")
    message(FATAL_ERROR "operation divergence was not explicit: ${LAST_OUTPUT}")
endif()
string(JSON changed SET "${recorded}" events 0 shared_state_after 0 value 99)
file(WRITE "${TEST_DIR}/snapshot.json" "${changed}")
run_cli(2 replay "${TEST_DIR}/snapshot.json")
string(JSON changed REMOVE "${recorded}" events 0 shared_state_after)
file(WRITE "${TEST_DIR}/partial-snapshot.json" "${changed}")
run_cli(2 replay "${TEST_DIR}/partial-snapshot.json")

# Preserve compatibility with saved v1 traces predating full shared snapshots.
set(legacy "${recorded}")
foreach(index RANGE 0 5)
    string(JSON legacy REMOVE "${legacy}" events ${index} shared_state_before)
    string(JSON legacy REMOVE "${legacy}" events ${index} shared_state_after)
    string(JSON legacy REMOVE "${legacy}" events ${index} wait_for)
    string(JSON legacy REMOVE "${legacy}" events ${index} type)
endforeach()
string(JSON legacy REMOVE "${legacy}" outcome shared_state)
string(JSON legacy REMOVE "${legacy}" outcome wait_for)
file(WRITE "${TEST_DIR}/legacy.json" "${legacy}")
run_cli(1 replay "${TEST_DIR}/legacy.json")
if(NOT LAST_OUTPUT MATCHES "Replay verified")
    message(FATAL_ERROR "legacy trace no longer replays")
endif()
run_cli(0 --help)
if(NOT LAST_OUTPUT MATCHES "mutex-ordered: Both workers acquire first, then second")
    message(FATAL_ERROR "scenario library descriptions are missing")
endif()
run_cli(1 run mutex-deadlock --schedule 0,1 --trace "${TEST_DIR}/cycle.json")
if(NOT LAST_OUTPUT MATCHES "T0=blocked T1=blocked" OR
   NOT LAST_OUTPUT MATCHES "lock first owner=T0" OR
   NOT LAST_OUTPUT MATCHES "lock second owner=T1" OR
   NOT LAST_OUTPUT MATCHES "T0 waits for T1 holding lock second" OR
   NOT LAST_OUTPUT MATCHES "T1 waits for T0 holding lock first" OR
   NOT LAST_OUTPUT MATCHES "Modeled wait-for cycle detected")
    message(FATAL_ERROR "deadlock explanation is missing: ${LAST_OUTPUT}")
endif()
file(READ "${TEST_DIR}/cycle.json" cycle)
string(JSON edge_count LENGTH "${cycle}" outcome wait_for)
string(JSON waiter GET "${cycle}" outcome wait_for 0 thread)
string(JSON owner GET "${cycle}" outcome wait_for 0 waits_for)
string(JSON kind GET "${cycle}" outcome wait_for 0 kind)
string(JSON resource GET "${cycle}" outcome wait_for 0 resource)
string(JSON event_type GET "${cycle}" events 0 type)
if(NOT edge_count EQUAL 2 OR NOT waiter EQUAL 0 OR NOT owner EQUAL 1 OR
   NOT kind STREQUAL "mutex" OR NOT resource STREQUAL "second" OR NOT event_type STREQUAL "lock_acquire")
    message(FATAL_ERROR "deadlock JSON lacks structured dependencies and event types")
endif()
run_cli(0 run mutex-ordered --schedule 0 --trace "${TEST_DIR}/ordered.json")
if(NOT LAST_OUTPUT MATCHES "status=completed steps=8" OR
   NOT LAST_OUTPUT MATCHES "T1 waits for T0 holding lock first" OR
   NOT LAST_OUTPUT MATCHES "lock first owner=none")
    message(FATAL_ERROR "corrected lock ordering did not complete or report waiting")
endif()
file(READ "${TEST_DIR}/ordered.json" ordered)
string(JSON changed SET "${ordered}" events 1 wait_for "[]")
file(WRITE "${TEST_DIR}/wrong-waits.json" "${changed}")
run_cli(2 replay "${TEST_DIR}/wrong-waits.json")
if(NOT LAST_OUTPUT MATCHES "divergence at step 1: wait-for graph")
    message(FATAL_ERROR "wait-for replay divergence was not explicit: ${LAST_OUTPUT}")
endif()
string(JSON changed SET "${cycle}" events 0 type "\"lock_release\"")
file(WRITE "${TEST_DIR}/wrong-type.json" "${changed}")
run_cli(2 replay "${TEST_DIR}/wrong-type.json")
if(NOT LAST_OUTPUT MATCHES "event type disagrees with operation")
    message(FATAL_ERROR "invalid event type was not rejected")
endif()
foreach(index RANGE 1 5)
    run_cli(1 replay "${TEST_DIR}/cycle.json")
    if(NOT LAST_OUTPUT MATCHES "Replay verified")
        message(FATAL_ERROR "cycle replay was not verified")
    endif()
    run_cli(0 replay "${TEST_DIR}/ordered.json")
    if(NOT LAST_OUTPUT MATCHES "Replay verified")
        message(FATAL_ERROR "ordered replay was not verified")
    endif()
endforeach()
run_cli(0 explore mutex-ordered --max-schedules 2 --max-steps 8)
if(NOT LAST_OUTPUT MATCHES "runs=2 failures=0 frontier_exhausted=true incomplete=false")
    message(FATAL_ERROR "corrected lock-order schedules failed")
endif()
run_cli(2 explore mutex-ordered --max-schedules 1 --max-steps 8)
run_cli(2 run mutex-ordered --max-steps 3 --trace "${TEST_DIR}/ordered-limit.json")
run_cli(2 replay "${TEST_DIR}/ordered-limit.json")
if(NOT LAST_OUTPUT MATCHES "Replay verified")
    message(FATAL_ERROR "corrected lock-order step bound did not replay")
endif()
message(STATUS "CLI run, explore, trace files, replay, divergence, and argument validation passed")
run_cli(1 explore lost-update --max-schedules 6 --max-steps 6 --all-traces --out "${TEST_DIR}/all-traces")
foreach(index RANGE 1 6)
    file(READ "${TEST_DIR}/all-traces/schedule-${index}.json" trace)
    string(JSON status GET "${trace}" outcome status)
    if(status STREQUAL "completed")
        run_cli(0 replay "${TEST_DIR}/all-traces/schedule-${index}.json")
    else()
        run_cli(1 replay "${TEST_DIR}/all-traces/schedule-${index}.json")
    endif()
endforeach()
run_cli(0 explore mutex-ordered --max-schedules 2 --max-steps 8 --all-traces --out "${TEST_DIR}/all-ordered")
run_cli(0 replay "${TEST_DIR}/all-ordered/schedule-1.json")
run_cli(0 replay "${TEST_DIR}/all-ordered/schedule-2.json")
run_cli(2 run lost-update --all-traces)

# Both directions are fresh controlled executions; the original is immutable.
file(SHA256 "${TEST_DIR}/failure.json" before)
run_cli(0 branch "${TEST_DIR}/failure.json" --step 1 --thread 0 --trace "${TEST_DIR}/branch-pass.json")
if(NOT LAST_OUTPUT MATCHES "Original replay verified" OR NOT LAST_OUTPUT MATCHES "schedule=0,0,1,1,2,2 counter=2")
    message(FATAL_ERROR "what-if failure-to-pass did not execute: ${LAST_OUTPUT}")
endif()
run_cli(0 replay "${TEST_DIR}/branch-pass.json")
run_cli(1 branch "${TEST_DIR}/branch-pass.json" --step 1 --thread 1 --trace "${TEST_DIR}/branch-fail.json")
run_cli(1 replay "${TEST_DIR}/branch-fail.json")
file(SHA256 "${TEST_DIR}/failure.json" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "branch changed the original trace")
endif()
run_cli(2 branch "${TEST_DIR}/failure.json" --step 1 --thread 2 --trace "${TEST_DIR}/invalid-prefix.json")
if(NOT LAST_OUTPUT MATCHES "T2 is not runnable at step 1; runnable=\\[0,1\\]")
    message(FATAL_ERROR "invalid branch lacks runnable-set diagnostic: ${LAST_OUTPUT}")
endif()
run_cli(2 branch "${TEST_DIR}/failure.json" --step 6 --thread 0)
run_cli(2 branch "${TEST_DIR}/failure.json" --step 1 --thread 0 --trace "${TEST_DIR}/failure.json")
file(CREATE_LINK "${TEST_DIR}/failure.json" "${TEST_DIR}/original-symlink.json" SYMBOLIC)
file(CREATE_LINK "${TEST_DIR}/failure.json" "${TEST_DIR}/original-hardlink.json")
run_cli(2 branch "${TEST_DIR}/failure.json" --step 1 --thread 0 --trace "${TEST_DIR}/original-symlink.json")
run_cli(2 branch "${TEST_DIR}/failure.json" --step 1 --thread 0 --trace "${TEST_DIR}/original-hardlink.json")
file(SHA256 "${TEST_DIR}/failure.json" after_aliases)
if(NOT before STREQUAL after_aliases)
    message(FATAL_ERROR "branch changed the original through a file alias")
endif()
run_cli(2 branch "${TEST_DIR}/divergent.json" --step 1 --thread 0 --trace "${TEST_DIR}/should-not-exist.json")
if(NOT LAST_OUTPUT MATCHES "original replay could not be verified" OR EXISTS "${TEST_DIR}/should-not-exist.json")
    message(FATAL_ERROR "stale original produced a comparison trace")
endif()
run_cli(0 branch "${TEST_DIR}/cycle.json" --step 1 --thread 0 --trace "${TEST_DIR}/branch-locks.json")
run_cli(0 replay "${TEST_DIR}/branch-locks.json")
run_cli(2 branch "${TEST_DIR}/limit.json" --step 0 --thread 1 --trace "${TEST_DIR}/branch-limit.json")
run_cli(2 replay "${TEST_DIR}/branch-limit.json")
